{
  "openapi": "3.1.0",
  "info": {
    "title": "PRISM-LLM Translator API",
    "description": "Микросервис машинного перевода новостей RU->EN для 1С-Битрикс с поддержкой корпоративного глоссария.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Локальное окружение разработки"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Healthcheck",
        "description": "Проверка доступности сервиса.",
        "responses": {
          "200": {
            "description": "Сервис готов к работе",
            "content": {
              "application/json": {
                "example": { "status": "ok" }
              }
            }
          }
        }
      }
    },
    "/api/v1/translate": {
      "post": {
        "summary": "Перевод новости RU -> EN",
        "description": "Принимает news_id, title, announce, detail_text и выполняет перевод с внедрением терминов глоссария.",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "M2M токен авторизации (BITRIX_AUTH_TOKEN)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["news_id"],
                "properties": {
                  "news_id": { "type": "integer", "example": 701 },
                  "title": { "type": "string", "example": "Выделение вычислительных мощностей для СУД" },
                  "announce": { "type": "string", "example": "В рамках сервисов КИС УАТ и ЕППО выделены ресурсы." },
                  "detail_text": { "type": "string", "example": "Для СУД выделены серверы..." },
                  "glossary": {
                    "type": "object",
                    "additionalProperties": { "type": "string" },
                    "example": { "ледокол": "icebreaker vessel" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный перевод",
            "content": {
              "application/json": {
                "example": {
                  "news_id": 701,
                  "translated_title": "Allocation of Computing Capacities for DMS",
                  "translated_announce": "Additional resources allocated for CIS ITARM and UPRP.",
                  "translated_detail_text": "Servers allocated for DMS...",
                  "meta": {
                    "model_used": "milmmt-12b",
                    "processing_time_ms": 2840,
                    "terms_applied": [
                      {
                        "term_id": "tn_0116",
                        "ru_term": "Служба управления данными",
                        "en_preferred": "Data Management Service (DMS)"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": { "description": "Неверный X-API-Key" },
          "422": { "description": "Ошибка валидации входных данных" }
        }
      }
    },
    "/api/v1/glossary/reload": {
      "post": {
        "summary": "Горячая перезагрузка глоссария",
        "description": "Перечитывает файл глоссария с диска и перестраивает лемма-индекс в RAM без перезапуска сервиса.",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "M2M токен авторизации (BITRIX_AUTH_TOKEN)"
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный сброс и построение индекса",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "message": "Glossary reloaded successfully",
                  "terms_count": 122
                }
              }
            }
          },
          "401": { "description": "Неверный X-API-Key" }
        }
      }
    }
  }
}
