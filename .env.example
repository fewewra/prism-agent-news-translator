# --- Config: General App ---
ENVIRONMENT=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Config: Security & Authorization ---
BITRIX_AUTH_TOKEN=sk_transneft_news_prod_change_me_in_env

# --- Config: LLM Backend ---
# Use "local" for local development with MLX MiLMMT 12B
# Use "litellm" for corporate perimeter vLLM/SGLang proxy
LLM_BACKEND=local
LOCAL_MODEL_PATH=models/milmmt

# --- Config: LiteLLM (for corporate perimeter) ---
LITELLM_BASE_URL=http://10.x.x.x:4000/v1
LITELLM_API_KEY=sk-prism-news-translator
TARGET_MODEL_NAME=qwen/qwen

# --- Config: Glossary ---
GLOSSARY_PATH=configs/glossary/transneft_glossary_v002.runtime.json

# --- Config: Langfuse ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
